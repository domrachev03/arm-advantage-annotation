# Copy this file to ~/.config/arm-advantage-annotation.env, replace every
# placeholder, and keep the resulting file mode 0600.

# Use an absolute path. Dataset videos, exports, the SQLite database, and the
# frame cache live below this directory unless individually overridden.
ARM_ANNOT_STATE=/home/annotator/.local/share/arm-advantage-annotation

# Empty when the app is exposed at the domain root. For a stripped reverse
# proxy path, use the public path with no trailing slash.
ARM_ANNOT_MOUNT=

# Set to 1 whenever users reach the app through HTTPS.
ARM_ANNOT_COOKIE_SECURE=1

# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
ARM_ANNOT_SECRET=replace-with-at-least-64-random-hex-characters

# Generate from a long password with:
# python -c 'import getpass,hashlib; print(hashlib.sha256(getpass.getpass().encode()).hexdigest())'
ARM_ANNOT_PASSWORD_SHA256=replace-with-the-sha256-password-digest

# Optional: required only for private or gated Hugging Face datasets.
# HF_TOKEN=hf_replace_me

# Optional defaults:
# ARM_ANNOT_SESSION_TTL_S=2592000
# ARM_NO_COMPLETION_CEILING=0.95
# ARM_ANNOT_DB=/absolute/path/to/annotations.db
# ARM_ANNOT_DATASETS=/absolute/path/to/datasets
# ARM_ANNOT_EXPORTS=/absolute/path/to/exports
# ARM_ANNOT_CACHE=/absolute/path/to/frame-cache
